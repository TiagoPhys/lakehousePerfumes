{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (gold.fato_vendas)",
      "queryLines": [
        "SELECT pedido_id, data_pedido, ano, mes, canal,\n",
        "       cliente_id, razao_social, segmento, cidade,\n",
        "       sku, categoria, marca, nota_olfativa,\n",
        "       quantidade, receita, custo, margem, devolucao\n",
        "FROM fato_vendas"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Receita liquida: quantidade vezes preco praticado, com a devolucao entrando negativa. Nao considera desconto comercial nem frete.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem",
          "description": "Receita menos o custo do produto. Nao considera desconto comercial nem frete.",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Pedidos distintos. O fato tem grao de ITEM, entao contar linhas daria numero de itens, nao de pedidos.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita dividida pelo numero de pedidos distintos.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Margem %",
          "description": "Margem dividida pela receita, entre 0 e 1 para o formato percentual.",
          "expression": "SUM(`margem`) / SUM(`receita`)"
        }
      ]
    }
  ],
